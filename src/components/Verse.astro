---
/**
 * A centered scripture quote. Pass the lines as <p> elements in the slot
 * and wrap "Lord" in <span class="lord">.
 */
interface Props {
  reference: string;
}

const { reference } = Astro.props;
---

<section
  aria-label={reference}
  class="flex justify-center px-6 pt-7 pb-8 md:px-16 md:pt-10 md:pb-11"
>
  <figure class="max-w-190 text-center">
    <blockquote class="font-serif text-xl/[1.3] tracking-[-0.005em] text-soft italic md:text-[32px]/[1.28] [&_p+p]:mt-[0.35em]">
      <slot />
    </blockquote>
    <figcaption class="mt-3 flex items-center justify-center gap-3.5 text-[11px] font-medium tracking-[0.16em] text-muted uppercase md:mt-4.5 md:text-xs">
      <span aria-hidden="true" class="block h-px w-5 bg-rule md:w-7"></span>
      <cite class="not-italic">{reference}</cite>
      <span aria-hidden="true" class="block h-px w-5 bg-rule md:w-7"></span>
    </figcaption>
  </figure>
</section>
