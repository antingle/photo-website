---
import { EMAIL, INSTAGRAM } from "~/config";

interface Props {
  class?: string;
  iconSize?: number;
}

const { class: className, iconSize = 20 } = Astro.props;
---

<ul aria-label="Contact" class:list={["flex list-none", className]}>
  <li>
    <a
      href={INSTAGRAM}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram (opens in a new tab)"
      class="inline-flex size-11 items-center justify-center text-ink hover:text-muted"
    >
      <svg
        width={iconSize}
        height={iconSize}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"></circle>
      </svg>
    </a>
  </li>
  <li>
    <a
      href={`mailto:${EMAIL}`}
      aria-label="Email"
      class="inline-flex size-11 items-center justify-center text-ink hover:text-muted"
    >
      <svg
        width={iconSize}
        height={iconSize}
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        aria-hidden="true"
      >
        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
        <path d="M3.5 6.5l8.5 6.5 8.5-6.5"></path>
      </svg>
    </a>
  </li>
</ul>
