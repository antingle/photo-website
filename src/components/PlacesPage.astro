---
/**
 * The Places page. Served at both "/" and "/places"; both declare "/" as the
 * canonical URL so search engines treat them as one page.
 */
import Hero from "~/components/Hero.astro";
import PhotoGallery from "~/components/PhotoGallery.astro";
import Verse from "~/components/Verse.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { listPhotos } from "~/lib/imagekit";

// Hero carousel: every photo in portfolio/places/hero, in upload order.
const heroes = (await listPhotos("portfolio/places/hero")).toSorted(
  (a, b) => Date.parse(a.createdAt) - Date.parse(b.createdAt)
);

// The gallery is the rest of portfolio/places. The old single "hero" file
// there is skipped; the hero folder replaces it.
const gallery = (await listPhotos("portfolio/places")).filter((p) => p.name !== "hero");
---

<BaseLayout title="Places" current="places" canonical="/">
  <h1 class="sr-only">Places — landscape photography by Anthony Ingle</h1>

  <Verse reference="Psalm 121:1–2">
    <p>
      I lift my eyes toward the mountains.
      <br />
      Where will my help come from?
    </p>
    <p>
      My help comes from the <span class="lord">Lord</span>,<br />
      the Maker of heaven and earth.
    </p>
  </Verse>

  {heroes.length > 0 && <Hero photos={heroes} fallbackAlt="Landscape photograph" />}

  <section class:list={["px-4 md:px-16", heroes.length > 0 ? "pt-10 md:pt-18" : "pt-2 md:pt-4"]}>
    <PhotoGallery photos={gallery} label="Landscapes" fallbackAlt="Landscape photograph" />
  </section>
</BaseLayout>
