---
import { placeholder, sized, srcset, type Photo } from "~/lib/imagekit";

interface Props {
  photo: Photo;
  alt: string;
}

const { photo, alt } = Astro.props;

// The hero is cropped to fill a fixed height (object-fit: cover). On tall
// screens that crop is wider than the viewport, so the browser must be told
// the drawn width (height × aspect ratio), not 100vw, or it picks a file too
// small and the photo looks soft. Keep the vh values in sync with the classes below.
const PHONE_HEIGHT_VH = 78;
const DESKTOP_HEIGHT_VH = 88;
const sizes = [
  `(max-width: 767px) ${Math.ceil(PHONE_HEIGHT_VH * photo.ratio)}vh`,
  `(orientation: portrait) ${Math.ceil(DESKTOP_HEIGHT_VH * photo.ratio)}vh`,
  "100vw",
].join(", ");
---

<figure>
  <img
    src={sized(photo, 1920)}
    srcset={srcset(photo)}
    sizes={sizes}
    width={photo.width}
    height={photo.height}
    alt={alt}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="block h-[78svh] w-full bg-well bg-cover object-cover object-[58%_center] md:h-[clamp(480px,88vh,980px)] md:object-center"
    style={`background-image: url(${placeholder(photo)})`}
  />
</figure>
