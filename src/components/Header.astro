---
import SocialLinks from "~/components/SocialLinks.astro";
import Wordmark from "~/components/Wordmark.astro";
import { LINKS, type PageKey } from "~/config";

interface Props {
  current?: PageKey;
}

const { current } = Astro.props;
---

{/*
 * The wrapper reserves the closed bar's height (56px phone / 68px desktop) in
 * the page layout. The glass bar is positioned inside it, so when the phone
 * menu expands the bar grows over the page instead of pushing content down.
 */}
<div class="sticky top-2 z-50 mx-6 mt-2 h-14 md:top-2.5 md:mx-20 md:mt-2.5 md:h-[68px]">
  <header data-site-header class="glass absolute inset-x-0 top-0 isolate">
    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-6 py-1 pr-1 pl-4 md:px-7 md:py-3">
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex list-none gap-7 text-[15px]">
          {LINKS.map(({ key, text, href }) => (
            <li>
              <a
                href={href}
                aria-current={key === current ? "page" : undefined}
                class:list={[
                  "nav-link transition-colors hover:text-ink",
                  key === current ? "text-ink" : "text-muted",
                ]}
              >
                {text}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <Wordmark class="col-start-1 md:col-start-2 md:justify-self-center" />

      <div class="col-start-3 flex justify-end">
        <SocialLinks class="hidden md:flex" />
        <button
          type="button"
          data-menu-toggle
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Menu"
          class="inline-flex size-12 items-center justify-center md:hidden"
        >
          <span class="menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>

    {/* Phone menu: the bar grows downward to reveal it. */}
    <div id="mobile-menu" class="menu-panel md:hidden" inert>
      <div class="overflow-hidden">
        <nav aria-label="Main" class="px-4 pt-1 pb-4">
          <ul class="flex list-none flex-col font-serif text-[30px]/[1.35]">
            {LINKS.map(({ key, text, href }, i) => (
              <li style={`--i: ${i}`}>
                <a
                  href={href}
                  aria-current={key === current ? "page" : undefined}
                  class:list={["block py-1", key === current ? "text-ink" : "text-muted"]}
                >
                  {text}
                </a>
              </li>
            ))}
          </ul>
          <div class="menu-socials mt-2 -ml-2.5" style={`--i: ${LINKS.length}`}>
            <SocialLinks />
          </div>
        </nav>
      </div>
    </div>
  </header>
</div>

<style>
  /*
   * The navbar is plain paper at the top of the page and turns into "liquid
   * glass" once the page scrolls or the phone menu opens (data-scrolled /
   * data-open are set by the script below).
   */
  .glass {
    border-radius: 18px;
    background: var(--color-paper);
    transition:
      background 0.3s ease,
      box-shadow 0.3s ease;
  }

  @media (min-width: 768px) {
    .glass {
      border-radius: 22px;
    }
  }

  /* Glossy diagonal sheen, only visible in the glass state. */
  .glass::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    /* Behind the text, above the glass (`isolate` makes the header its own stacking context). */
    z-index: -1;
    background: linear-gradient(
      115deg,
      rgb(255 255 255 / 0.55) 0%,
      rgb(255 255 255 / 0.12) 32%,
      rgb(255 255 255 / 0) 55%,
      rgb(255 255 255 / 0.16) 100%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .glass[data-scrolled],
  .glass[data-open] {
    /* White enough for legible text, while still letting color through. */
    background: linear-gradient(180deg, rgb(255 255 255 / 0.75), rgb(250 250 248 / 0.62));
    backdrop-filter: blur(14px) saturate(160%) brightness(1.04);
    -webkit-backdrop-filter: blur(14px) saturate(160%) brightness(1.04);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.95),
      inset 0 12px 18px -14px rgb(255 255 255 / 0.9),
      inset 0 -10px 18px -14px rgb(22 22 22 / 0.08),
      0 12px 32px -8px rgb(22 22 22 / 0.18),
      0 2px 6px rgb(22 22 22 / 0.06);
  }

  .glass[data-scrolled]::before,
  .glass[data-open]::before {
    opacity: 1;
  }

  /* Slightly darker inactive links on glass, so they never wash out over a photo. */
  .glass[data-scrolled] .nav-link:not([aria-current="page"]) {
    color: #4f4f4b;
  }

  /* --- Phone menu ------------------------------------------------------ */

  /* Animating grid rows from 0fr to 1fr expands to the content's real height. */
  .menu-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .glass[data-open] .menu-panel {
    grid-template-rows: 1fr;
  }

  .menu-panel li,
  .menu-socials {
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .glass[data-open] .menu-panel li,
  .glass[data-open] .menu-socials {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.3s ease calc(80ms + var(--i) * 45ms),
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) calc(80ms + var(--i) * 45ms);
  }

  /* Hamburger that turns into an ×. */
  .menu-icon {
    position: relative;
    width: 20px;
    height: 12px;
  }

  .menu-icon > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.6px;
    border-radius: 1px;
    background: currentColor;
    transition:
      top 0.3s ease,
      transform 0.3s ease;
  }

  .menu-icon > span:first-child {
    top: 0;
  }

  .menu-icon > span:last-child {
    top: calc(100% - 1.6px);
  }

  [aria-expanded="true"] .menu-icon > span {
    top: calc(50% - 0.8px);
  }

  [aria-expanded="true"] .menu-icon > span:first-child {
    transform: rotate(45deg);
  }

  [aria-expanded="true"] .menu-icon > span:last-child {
    transform: rotate(-45deg);
  }

  /* People who ask their OS for less transparency get a solid bar. */
  @media (prefers-reduced-transparency: reduce) {
    .glass[data-scrolled],
    .glass[data-open] {
      background: rgb(250 250 248 / 0.98);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glass,
    .glass::before,
    .menu-panel,
    .menu-panel li,
    .menu-socials,
    .menu-icon > span {
      transition: none !important;
    }
  }
</style>

<script>
  const header = () => document.querySelector<HTMLElement>("[data-site-header]");

  // Liquid glass once the page scrolls; plain paper at the top.
  const updateScrolled = () => header()?.toggleAttribute("data-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", updateScrolled, { passive: true });

  const setMenu = (open: boolean) => {
    const el = header();
    if (!el) return;
    el.toggleAttribute("data-open", open);
    el.querySelector("[data-menu-toggle]")?.setAttribute("aria-expanded", String(open));
    el.querySelector<HTMLElement>("#mobile-menu")?.toggleAttribute("inert", !open);
  };

  document.addEventListener("astro:page-load", () => {
    updateScrolled();
    setMenu(false);

    const el = header();
    if (!el) return;
    el.querySelector("[data-menu-toggle]")?.addEventListener("click", () =>
      setMenu(!el.hasAttribute("data-open"))
    );
    el.querySelectorAll("#mobile-menu a").forEach((a) =>
      a.addEventListener("click", () => setMenu(false))
    );
  });

  // Close on Escape or a tap outside the bar.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
  document.addEventListener("click", (e) => {
    const el = header();
    if (el?.hasAttribute("data-open") && !el.contains(e.target as Node)) setMenu(false);
  });
</script>
