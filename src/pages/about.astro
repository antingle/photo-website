---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { EMAIL, INSTAGRAM } from "~/config";
import { getPhoto, placeholder, sized, srcset } from "~/lib/imagekit";

const me = await getPhoto("me", "anthony");
---

<BaseLayout title="About" current="about">
  <section
    aria-labelledby="about-h"
    class="flex flex-wrap items-start gap-10 px-5 pt-8 md:gap-18 md:px-16 md:pt-18"
  >
    <img
      src={sized(me, 1080)}
      srcset={srcset(me)}
      sizes="(max-width: 767px) 100vw, 540px"
      width={me.width}
      height={me.height}
      alt="Anthony Ingle"
      loading="eager"
      class="block w-full max-w-135 flex-[1_1_380px] bg-well bg-cover object-cover"
      style={`aspect-ratio: ${me.ratio}; background-image: url(${placeholder(me)})`}
    />

    <div class="max-w-145 flex-[1_1_420px] text-lg/relaxed md:pt-6">
      <h1 id="about-h" class="mb-7 font-serif text-[44px]/[1.05] md:text-[56px]">
        Hi, I'm Anthony.
      </h1>
      {/* TODO: finish the bio (landscapes, people, where you're based). */}
      <p class="mb-9">
        One of my favorite things to hold in my hands is my camera. I love capturing moments that
        will be remembered forever.
      </p>
      <div class="flex flex-col gap-1.5 border-t border-line pt-6 text-base">
        <span class="text-xs font-medium tracking-[0.16em] text-muted uppercase">Say hello</span>
        <a href={`mailto:${EMAIL}`} class="underline-offset-4 hover:underline">
          {EMAIL}
        </a>
        <a
          href={INSTAGRAM}
          target="_blank"
          rel="noopener noreferrer"
          class="underline-offset-4 hover:underline"
        >
          @ant.ing on Instagram<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
