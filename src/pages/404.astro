---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <section class="flex flex-col items-center px-6 pt-24 text-center md:pt-32">
    <h1 class="font-serif text-5xl">Nothing here</h1>
    <p class="mt-3 text-muted">This page doesn't exist, or it moved.</p>
    <a
      href="/places"
      class="mt-8 inline-flex min-h-12 items-center bg-ink px-6 font-medium text-paper hover:bg-ink/85"
    >
      Back to Places
    </a>
  </section>
</BaseLayout>
