---
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "~/styles/base.css";

import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import { DESCRIPTION, NAME, TWITTER_CREATOR, type PageKey } from "~/config";

interface Props {
  title: string;
  description?: string;
  /** Use the post title on its own (blog posts) instead of "Title | Name". */
  blogTitle?: string;
  socialImage?: string;
  current?: PageKey;
  /** Path of the page search engines should index, when the same page lives at several URLs. */
  canonical?: string;
}

const { title, description, blogTitle, socialImage, current, canonical } = Astro.props;

const finalTitle = blogTitle ?? `${title} | ${NAME}`;
const finalDescription = description ?? DESCRIPTION;
const finalImage = socialImage ?? new URL("/social.jpg", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
    <link rel="preconnect" href="https://ik.imagekit.io" />
    <meta name="theme-color" content="#fafaf8" />

    <SEO
      title={finalTitle}
      description={finalDescription}
      canonical={canonical ? new URL(canonical, Astro.site ?? Astro.url) : undefined}
      openGraph={{ basic: { title: finalTitle, type: "website", image: finalImage } }}
      twitter={{
        card: "summary_large_image",
        creator: TWITTER_CREATOR,
        title: finalTitle,
        description: finalDescription,
        image: finalImage,
      }}
    />
    <SpeedInsights />
    <Analytics />
    <ClientRouter />
  </head>
  <body>
    <Header current={current} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
