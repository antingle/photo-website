---
import "@fontsource/cormorant-garamond/400.css";
import "@fontsource/cormorant-garamond/400-italic.css";
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource-variable/instrument-sans/wght.css";
import "~/styles/base.css";

import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import { DESCRIPTION, NAME, TWITTER_CREATOR, type PageKey } from "~/config";
import { getPhoto, socialImage as socialImageOf } from "~/lib/imagekit";

interface Props {
  title: string;
  description?: string;
  /** Use the post title on its own (blog posts) instead of "Title | Name". */
  blogTitle?: string;
  /** Link-preview image URL. Defaults to the Places hero photo. */
  socialImage?: string;
  socialImageAlt?: string;
  current?: PageKey;
  /** Path of the page search engines should index, when the same page lives at several URLs. */
  canonical?: string;
}

const { title, description, blogTitle, socialImage, socialImageAlt, current, canonical } =
  Astro.props;

const finalTitle = blogTitle ?? `${title} | ${NAME}`;
const finalDescription = description ?? DESCRIPTION;

// Default link preview: the hero photo, cropped by ImageKit to 1200×630.
const hero = socialImage ? undefined : await getPhoto("portfolio/places", "hero");
const finalImage = socialImage ?? socialImageOf(hero!);
const finalImageAlt =
  socialImageAlt ??
  (hero ? hero.alt || "Aerial view of fog drifting over coastal cliffs and the ocean" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preconnect" href="https://ik.imagekit.io" />
    <meta name="theme-color" content="#fafaf8" />

    <SEO
      title={finalTitle}
      description={finalDescription}
      canonical={canonical ? new URL(canonical, Astro.site ?? Astro.url) : undefined}
      openGraph={{
        basic: { title: finalTitle, type: "website", image: finalImage },
        optional: { description: finalDescription, siteName: NAME },
        image: hero
          ? { type: "image/jpeg", width: 1200, height: 630, alt: finalImageAlt }
          : { alt: finalImageAlt },
      }}
      twitter={{
        card: "summary_large_image",
        creator: TWITTER_CREATOR,
        title: finalTitle,
        description: finalDescription,
        image: finalImage,
        imageAlt: finalImageAlt,
      }}
    />
    <SpeedInsights />
    <Analytics />
    <ClientRouter />
  </head>
  <body>
    <Header current={current} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
